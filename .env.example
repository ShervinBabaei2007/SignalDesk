# SignalDesk backend configuration (copy to .env and edit)

# development | production
APP_ENV=development

# Comma-separated allowed origins for the API. "*" is fine for local dev;
# in production list your dashboard origin(s) explicitly, e.g.
# CORS_ORIGINS=https://dash.example.com
CORS_ORIGINS=*

# LOG_LEVEL=INFO

# Auto-ingest interval in minutes (0 disables the scheduler)
INGEST_INTERVAL_MINUTES=15

# Minimum seconds between manual ingests (protects against hammering feeds)
INGEST_COOLDOWN_SECONDS=20

# Articles enriched per background wave
ENRICH_BATCH_SIZE=30

# Set SCHEDULER_DISABLED=true in tests/CI to prevent network calls on boot
# SCHEDULER_DISABLED=false

# Database: SQLite by default; point at Postgres in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/signaldesk

# Only ingest stories published within this many days (0 disables the filter)
# MAX_ARTICLE_AGE_DAYS=7

# --- Optional LLM analysis (any OpenAI-compatible endpoint) -------------------
# Off by default; the offline deterministic analyzer always works.
# LLM_ENABLED=true
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1     # or http://localhost:11434/v1 for Ollama
# LLM_MODEL=gpt-4o-mini

# --- Optional semantic clustering (any OpenAI-compatible /embeddings endpoint) ----
# Off by default: clustering then uses headline wording only. Base URL and key default to the LLM_* ones.
# Only shared articles are embedded (never a visitor's), so it costs a few cents a day on a busy feed set.
# EMBEDDINGS_ENABLED=true
# EMBEDDING_MODEL=text-embedding-3-small     # or e.g. nomic-embed-text on Ollama
# EMBEDDING_BASE_URL=                        # defaults to LLM_BASE_URL
# EMBEDDING_API_KEY=                         # defaults to LLM_API_KEY
# EMBEDDING_DIMENSIONS=256                   # smaller vectors are cheaper to store; 0 keeps the model's size
# EMBED_SIM_MIN=0.78                         # cosine for "same event"; tune per model on your own feeds

# --- Optional daily brief delivery -------------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DIGEST_EMAILS=team@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=signaldesk@example.com
# DIGEST_HOUR=8        # UTC hour for automatic delivery; -1 disables

# --- Optional write protection -----------------------------------------------
# When set, POST/DELETE need header "X-API-Key: <token>" (or Bearer token).
# API_TOKEN=change-me

# --- Vercel deployment ---------------------------------------------------------
# Vercel Cron calls /api/cron/ingest with "Authorization: Bearer <CRON_SECRET>".
# On Vercel also set SCHEDULER_DISABLED=true and a Postgres DATABASE_URL.
# CRON_SECRET=generate-a-long-random-string

# Private workspaces: every visitor gets their own feeds and watchlist, isolated from everyone else.
# Tokens are signed with SESSION_SECRET, which defaults to API_TOKEN (workspaces are off when neither is set).
# SESSION_SECRET=generate-a-long-random-string
# WORKSPACE_TTL_DAYS=7
# WORKSPACE_MAX_FEEDS=8
# WORKSPACE_MAX_WATCHES=10
# WORKSPACE_MAX_ARTICLES=600
# WORKSPACE_CREATES_PER_HOUR=20

# Demo mode: the landing page's demo tour hands visitors a 2-hour token that can only run ingests.
# DEMO_MODE=true
# DEMO_TTL_SECONDS=7200
