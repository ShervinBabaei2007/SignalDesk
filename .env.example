# --- Optional configuration -------------------------------------------------
# SignalDesk works out of the box with SQLite and zero configuration.
# Everything below is optional.

# Use PostgreSQL instead of SQLite (e.g. in production):
# DATABASE_URL=postgresql://user:password@localhost:5432/signaldesk

# Auto-pilot: re-ingest every active feed every N minutes (0 disables)
INGEST_INTERVAL_MINUTES=30

# Server
HOST=0.0.0.0
PORT=8000
