# SignalDesk backend configuration (copy to .env and edit)

# development | production
APP_ENV=development

# Comma-separated allowed origins for the API. "*" is fine for local dev;
# in production list your dashboard origin(s) explicitly, e.g.
# CORS_ORIGINS=https://dash.example.com
CORS_ORIGINS=*

# LOG_LEVEL=INFO

# Auto-ingest interval in minutes (0 disables the scheduler)
INGEST_INTERVAL_MINUTES=30

# Minimum seconds between manual ingests (protects against hammering feeds)
INGEST_COOLDOWN_SECONDS=20

# Articles enriched per background wave
ENRICH_BATCH_SIZE=30

# Set SCHEDULER_DISABLED=true in tests/CI to prevent network calls on boot
# SCHEDULER_DISABLED=false

# Database: SQLite by default; point at Postgres in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/signaldesk

# Only ingest stories published within this many days (0 disables the filter)
# MAX_ARTICLE_AGE_DAYS=7

# --- Optional LLM analysis (any OpenAI-compatible endpoint) -------------------
# Off by default; the offline deterministic analyzer always works.
# LLM_ENABLED=true
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1     # or http://localhost:11434/v1 for Ollama
# LLM_MODEL=gpt-4o-mini

# --- Optional daily brief delivery -------------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DIGEST_EMAILS=team@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=signaldesk@example.com
# DIGEST_HOUR=8        # UTC hour for automatic delivery; -1 disables

# --- Optional write protection -----------------------------------------------
# When set, POST/DELETE need header "X-API-Key: <token>" (or Bearer token).
# API_TOKEN=change-me
